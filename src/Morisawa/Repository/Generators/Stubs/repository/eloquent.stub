<?php

$NAMESPACE$

use Morisawa\Repository\Eloquent\BaseRepository;
use $REPOSITORY$
use $PRESENTER$
use $MODEL$;

/**
 * Class $CLASS$RepositoryEloquent.
 * @note 
 * @package $NAMESPACE$
 */
class $CLASS$RepositoryEloquent extends BaseRepository implements $CLASS$Repository
{
    protected string $mode = 'internal';

    /**
     * Specify Model class name
     *
     * @return string
     */
    public function model()
    {
        return $CLASS$::class;
    }

    public function setMode($mode): static
    {
        $this->mode = $mode; //这块设置了默认--要重新调用
        return $this->setPresenter($this->presenter());
    }

    public function presenter()
    {
        return app()->makeWith($CLASS$Presenter::class, [
            'mode' => $this->mode
        ]);
    }

    /**
     * Boot up the repository, pushing criteria
     */
    public function boot()
    {

    }

}
