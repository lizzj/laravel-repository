<?php
$NAMESPACE$

use Illuminate\Foundation\Http\FormRequest;

/**
 * Class $CLASS$Request.
 * @note
 * @package $NAMESPACE$
 */
class $CLASS$Request extends FormRequest
{
    /**
     * If set to true, the validation will stop on the first failure.
     * This helps in reducing unnecessary validation overhead and provides faster feedback.
     *
     * @var bool
     */
    protected $stopOnFirstFailure = true;

    public string $langPath = "_Validation.$MESSAGES$";

    /**
     * Get the validation rules that apply to the request.
     */
    public function rules(): array
    {
        return [
            //
        ];
    }
    /**
     * Get the custom validation error messages.
    */
    public function messages()
    {
         return is_array($translation = trans($this->langPath)) ? $translation : ["*" => trans('_Validation.Failed')];
    }
}
